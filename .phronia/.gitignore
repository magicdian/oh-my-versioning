# Developer identity (local only)
.developer

# Current task pointer (each dev works on different task)
.current-task

# Session/window scoped runtime state
.runtime/

# Runtime adapter manifest (machine-local detection result)
manifest.json

# Legacy task worktrees (kept so pre-existing checkouts stay ignored).
# The current default root (`.phronia-workspace/`) lives at the repository
# root and is ignored there by Phronia's managed `# PHRONIA:START` block.
worktrees/

# Ralph Loop state file
.ralph-state.json

# Agent runtime files
.agents/
.agent-log
.session-id

# Task directory runtime files
.plan-log

# Atomic update temp files
*.tmp

# Update backup directories
.backup-*

# Conflict resolution temp files
*.new

# Python cache
**/__pycache__/
**/*.pyc
