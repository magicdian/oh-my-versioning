{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/bridge.mjs",
              "--event",
              "session-start"
            ],
            "timeoutMs": 30000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/bridge.mjs",
              "--event",
              "user-prompt"
            ],
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/bridge.mjs",
              "--event",
              "subagent-spawn"
            ],
            "timeoutMs": 30000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/bridge.mjs",
              "--event",
              "pre-shell"
            ],
            "timeoutMs": 15000
          }
        ]
      }
    ]
  }
}
